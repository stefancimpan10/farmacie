<UserControl x:Class="NivelUIWPF.PaginaConfigurare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="⚙️ Configurare Sistem" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <GroupBox Header="Setări Generale" Margin="0,0,0,20">
            <StackPanel Margin="10">
                <CheckBox Content="Deschide casa de marcat automat la vânzare" Margin="0,5"/>
                <CheckBox Content="Afișează avertisment la produse cu stoc mic (&lt; 5 buc)" Margin="0,5" IsChecked="True"/>
                <CheckBox Content="Salvează backup automat zilnic" Margin="0,5" IsChecked="True"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Utilizator Curent">
            <StackPanel Margin="10">
                <TextBlock Text="Farmacist: Dr. Popescu Ion" FontWeight="Bold"/>
                <Button Content="Schimbă Parola" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>