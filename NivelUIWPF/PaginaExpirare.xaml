<UserControl x:Class="NivelUIWPF.PaginaExpirare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="⚠️ Alertă Expirare Produse" FontSize="24" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,20"/>

        <TextBlock Text="Următoarele produse expiră în mai puțin de 90 de zile și necesită retragere urgentă din raft:" 
                   Margin="0,0,0,15" FontStyle="Italic"/>

        <DataGrid AutoGenerateColumns="False" IsReadOnly="True" Background="#FFF5F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produs" Binding="{Binding Nume}" Width="*"/>
                <DataGridTextColumn Header="Lot" Binding="{Binding Lot}" Width="80"/>
                <DataGridTextColumn Header="Data Expirării" Binding="{Binding DataExp}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Red"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Zile Rămase" Binding="{Binding ZileRamase}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>