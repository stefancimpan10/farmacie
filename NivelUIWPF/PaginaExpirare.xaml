<UserControl x:Class="NivelUIWPF.PaginaExpirare"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⚠️ Alerte Expirare Produse" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" Foreground="#E74C3C"/>

            <ComboBox x:Name="CmbPerioada" Width="200" Margin="20,0,0,0" SelectedIndex="0" SelectionChanged="CmbPerioada_SelectionChanged">
                <ComboBoxItem Content="Următoarele 30 de Zile"/>
                <ComboBoxItem Content="Următoarele 3 Luni"/>
                <ComboBoxItem Content="Următoarele 6 Luni"/>
                <ComboBoxItem Content="Următorul An"/>
            </ComboBox>
        </StackPanel>

        <DataGrid x:Name="DgExpirare" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" AlternatingRowBackground="#FFF0F0" BorderBrush="#E74C3C" BorderThickness="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nume Medicament" Binding="{Binding Nume}" Width="2*"/>
                <DataGridTextColumn Header="Data Expirării Simulată" Binding="{Binding DataExpirareSimulata, StringFormat=dd.MM.yyyy}" Width="150"/>
                <DataGridTextColumn Header="Zile Rămase" Binding="{Binding ZileRamase}" Width="100" FontWeight="Bold" Foreground="Red"/>
                <DataGridTextColumn Header="Stoc" Binding="{Binding Stoc}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>