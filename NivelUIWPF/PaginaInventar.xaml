<UserControl x:Class="NivelUIWPF.PaginaInventar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="📋 Inventar Stoc Farmacie" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtCautaInventar" Width="300" Margin="20,0,0,0" Padding="5" 
                     TextChanged="TxtCautaInventar_TextChanged" ToolTip="Caută după nume..."/>
        </StackPanel>

        <DataGrid x:Name="DgInventar" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" AlternatingRowBackground="#F0F0F0" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nume Medicament" Binding="{Binding Nume}" Width="2*"/>
                <DataGridTextColumn Header="Preț Vânzare (RON)" Binding="{Binding Pret, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Stoc Disponibil" Binding="{Binding Stoc}" Width="100"/>
                <DataGridTextColumn Header="Valoare Stoc (RON)" Binding="{Binding ValoareStoc, StringFormat=N2}" Width="120" FontWeight="Bold"/>
                <DataGridCheckBoxColumn Header="Cu Rețetă?" Binding="{Binding NecesitaReteta}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock Text="Valoare Totală Stoc: " FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtValoareTotala" Text="0.00 RON" FontSize="16" FontWeight="Bold" Foreground="#27AE60" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>