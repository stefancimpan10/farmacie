<UserControl x:Class="NivelUIWPF.PaginaPanouControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- RESURSELE STILISTICE TREBUIE SĂ FIE AICI -->
    <UserControl.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#ECF0F1"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D5DBDB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="10">
            <TextBlock Text="📊 Panou Control &amp; Statistici" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <!-- FILTRE DE TIMP -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <TextBlock Text="Perioada:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                <Button Content="Azi" Click="BtnFiltru_Click" Tag="Azi" Style="{StaticResource FilterButtonStyle}"/>
                <Button Content="Săptămâna Aceasta" Click="BtnFiltru_Click" Tag="Saptamana" Style="{StaticResource FilterButtonStyle}"/>
                <Button Content="Luna Aceasta" Click="BtnFiltru_Click" Tag="Luna" Style="{StaticResource FilterButtonStyle}"/>
                <Button Content="Anul Curent" Click="BtnFiltru_Click" Tag="An" Style="{StaticResource FilterButtonStyle}"/>
            </StackPanel>

            <WrapPanel>
                <!-- Card 1: Total Încasări -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,20,20" Width="280" Height="160">
                    <StackPanel>
                        <TextBlock Text="Total Încasări" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="TxtTotal" Text="0.00 RON" FontSize="32" FontWeight="Bold" Foreground="#27AE60" Margin="0,10,0,0"/>
                        <TextBlock x:Name="LblPerioada" Text="(pentru Azi)" HorizontalAlignment="Right" Foreground="Gray" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Număr Comenzi -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,20,20" Width="280" Height="160">
                    <StackPanel>
                        <TextBlock Text="Număr Comenzi" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="TxtNrComenzi" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2980B9" Margin="0,10,0,0"/>
                        <TextBlock Text="Bonuri fiscale emise" HorizontalAlignment="Right" Foreground="Gray"/>
                    </StackPanel>
                </Border>

                <!-- Card 3: Valoare Medie -->
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,20,20" Width="280" Height="160">
                    <StackPanel>
                        <TextBlock Text="Valoare Medie / Comandă" Foreground="Gray" FontSize="14"/>
                        <TextBlock x:Name="TxtMedie" Text="0.00 RON" FontSize="32" FontWeight="Bold" Foreground="#8E44AD" Margin="0,10,0,0"/>
                        <TextBlock Text="Media vânzărilor" HorizontalAlignment="Right" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <TextBlock Text="Activitate Recentă" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
            <Border Background="White" CornerRadius="5" Padding="10" Height="200">
                <ListBox x:Name="LstActivitateRecents" BorderThickness="0"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>