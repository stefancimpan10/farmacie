<UserControl x:Class="NivelUIWPF.PaginaReceptie"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ZONA DE SUS: Introducere Produs (Centrat Vertical & Etichete Complete) -->
        <Border Background="#F9F9F9" Padding="10" CornerRadius="5" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 1. PRODUS -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Produs:" FontWeight="SemiBold" FontSize="11" Foreground="#444" Margin="0,0,0,2"/>
                    <ComboBox x:Name="CmbProduseReceptie" IsEditable="True" KeyUp="CmbProduseReceptie_KeyUp" 
                              DisplayMemberPath="Nume" Height="28" Padding="4,0" FontSize="13"
                              VerticalContentAlignment="Center"/>
                    <!-- Centrat vertical -->
                </StackPanel>

                <!-- 2. CANTITATE -->
                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="Cantitate:" FontWeight="SemiBold" FontSize="11" Foreground="#444" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtCantitateIntrare" Text="10" Height="28" Padding="4,0" FontSize="13"
                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                    <!-- Centrat pe ambele axe -->
                </StackPanel>

                <!-- 3. PREȚ ACHIZIȚIE (PE BUCATĂ) -->
                <StackPanel Grid.Column="2" Margin="5,0">
                    <TextBlock Text="Preț Achiziție (buc):" FontWeight="SemiBold" FontSize="11" Foreground="#444" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtPretAchizitie" Text="0.00" Height="28" Padding="4,0" FontSize="13"
                             HorizontalContentAlignment="Right" VerticalContentAlignment="Center"/>
                    <!-- Aliniat dreapta + centrat vertical -->
                </StackPanel>

                <!-- 4. DATA EXPIRĂRII -->
                <StackPanel Grid.Column="3" Margin="5,0">
                    <TextBlock Text="Expiră la:" FontWeight="SemiBold" FontSize="11" Foreground="#444" Margin="0,0,0,2"/>
                    <DatePicker x:Name="DpExpirare" Height="28" Padding="4,0" FontSize="13"
                                VerticalContentAlignment="Center"/>
                    <!-- Centrat vertical -->
                </StackPanel>

                <!-- 5. BUTON -->
                <Button Grid.Column="4" Content="➕ Adaugă" Click="BtnAdaugaInLista_Click" 
                        Width="90" Height="28" Margin="10,0,0,0" VerticalAlignment="Bottom"
                        Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="12"/>
            </Grid>
        </Border>

        <!-- ZONA DE MIJLOC: Tabel Coș Intrare -->
        <DataGrid x:Name="DgListaIntrare" Grid.Row="1" AutoGenerateColumns="False" 
                  IsReadOnly="True" AlternatingRowBackground="#FAFAFA" BorderBrush="#E0E0E0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Produs" Binding="{Binding Nume}" Width="2*"/>
                <DataGridTextColumn Header="Cantitate" Binding="{Binding Cantitate}" Width="100"/>
                <DataGridTextColumn Header="Preț Achiziție" Binding="{Binding PretAchizitie, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Total Linie" Binding="{Binding TotalLinie, StringFormat=N2}" Width="120" FontWeight="Bold"/>
                <DataGridTextColumn Header="Expiră la" Binding="{Binding DataExpirare}" Width="120"/>
                <DataGridTemplateColumn Header="Acțiuni" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑️" Click="BtnStergeLinie_Click" Tag="{Binding}" 
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Șterge linia"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ZONA DE JOS: Total și Finalizare -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                <TextBlock Text="Valoare Totală Intrare:" FontSize="14" Foreground="#555"/>
                <TextBlock x:Name="TxtTotalIntrare" Text="0.00 RON" FontSize="20" FontWeight="Bold" Foreground="#27AE60"/>
            </StackPanel>

            <Button Content="✅ FINALIZEAZĂ INTRAREA ÎN STOC" 
                    Click="BtnFinalizeazaIntrarea_Click" 
                    Padding="25,12" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>